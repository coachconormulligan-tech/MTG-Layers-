    {
      "fire": "@servitor",
      "trigger": 1,
      "as": "fired"
    }
  ],
  "asserts": [
    {
      "perm": "Barbed Servitor",
      "final": {
        "abilities": {
          "$includes": [
            "Menace"
          ]
        },
        "traits": {
          "$includes": [
            "Suspected"
          ]
        }
      }
    },
    {
      "perm": "Grizzly Bears",
      "final": {
        "abilities": {
          "$excludes": [
            "Menace"
          ]
        }
      }
    }
  ]
