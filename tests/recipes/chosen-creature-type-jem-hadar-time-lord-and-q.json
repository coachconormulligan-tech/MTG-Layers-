      "perm": "Adaptive Automaton A",
      "final": {
        "subtypes": [
          "Construct",
          "Jem'Hadar"
        ]
      }
    },
    {
      "perm": "Adaptive Automaton B",
      "final": {
        "subtypes": [
          "Construct",
          "Time Lord"
        ]
      }
    },
    {
      "perm": "Adaptive Automaton C",
      "final": {
        "subtypes": [
          "Construct",
          "Q"
        ]
      }
    }
  ]
}
