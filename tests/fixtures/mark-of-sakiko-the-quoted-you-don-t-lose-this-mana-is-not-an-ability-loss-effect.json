  "steps": [
   {
    "add": "Grizzly Bears",
    "as": "b"
   },
   {
    "add": "Mark of Sakiko",
    "as": "m"
   },
   {
    "call": [
     "setTarget",
     "@m",
     "@b"
    ]
   }
  ]
 },
