    "add": "Grizzly Bears",
    "as": "bears"
   },
   {
    "add": "Lizard Blades",
    "as": "blades"
   },
   {
    "call": [
     "addCounter",
     "@bears",
     "Flying",
     1
    ]
   },
   {
    "call": [
     "setTarget",
     "@blades",
     "@bears"
    ]
   }
  ]
 },
